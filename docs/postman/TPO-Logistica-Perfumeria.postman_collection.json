      ]
    },
    {
      "name": "10. Floyd-Warshall",
      "item": [
        {
          "name": "Todos contra todos",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/caminos/floyd-warshall" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
