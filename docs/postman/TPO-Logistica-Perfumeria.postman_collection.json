            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Capacidad 50 kg y 3 cajas', () => {",
            "    pm.expect(r.capacidadKg).to.eql(50);",
            "    pm.expect(r.juegoDeDatos).to.have.lengthOf(3);",
