            "    pm.expect(r.paquetesCargados.reduce((s, p) => s + p.pesoKg, 0)).to.eql(r.pesoTotalKg);",
            "});",
            "pm.test('Sin tabla si no se pide', () => pm.expect(r.tablaDp).to.eql(null));"
          ]}}]
        },
        {
          "name": "Mochila 40 kg con tabla dp",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/paquetes/mochila?capacidadKg=40&incluirTabla=true" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
