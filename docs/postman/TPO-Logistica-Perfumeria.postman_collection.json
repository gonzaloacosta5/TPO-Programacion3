        {
          "name": "Mochila 40 kg",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/paquetes/mochila?capacidadKg=40" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Valor óptimo 1960 USD en 40 kg', () => {",
            "    pm.expect(r.valorOptimo).to.eql(1960);",
            "    pm.expect(r.pesoTotalKg).to.eql(40);",
