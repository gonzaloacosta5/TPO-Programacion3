{
  "info": {
    "name": "TPO Logística Perfumería",
    "description": "Todos los endpoints de la API con tests. Los valores esperados son los de la red semilla (12 nodos, 17 rutas, 8 cajas) documentados en docs/ENDPOINTS.md. Requiere la API corriendo en {{baseUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('[general] responde JSON', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
          "});",
          "pm.test('[general] nunca un 500 ni un stack trace', function () {",
          "    pm.expect(pm.response.code).to.not.equal(500);",
          "    pm.expect(pm.response.text()).to.not.match(/at (com|org|java)\\.[\\w.$]+\\(/);",
          "    pm.expect(pm.response.text()).to.not.include('Exception');",
          "});",
          "pm.test('[general] responde en menos de 3 s', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(3000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Datos del grafo",
      "item": [
        {
          "name": "Resumen",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/grafo/resumen" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('12 nodos, 17 rutas, 8 cajas', () => {",
            "    pm.expect(r.vertices).to.eql(12);",
            "    pm.expect(r.aristas).to.eql(17);",
            "    pm.expect(r.paquetes).to.eql(8);",
            "});",
            "pm.test('Nodos por tipo: 2 depósitos, 5 centros, 5 retiros', () => {",
            "    pm.expect(r.nodosPorTipo).to.eql({ DEPOSITO: 2, CENTRO_DISTRIBUCION: 5, PUNTO_RETIRO: 5 });",
            "});",
            "pm.test('Grafo no dirigido, costo en minutos', () => {",
            "    pm.expect(r.dirigido).to.eql(false);",
            "    pm.expect(r.unidadCosto).to.eql('minutos');",
            "});"
          ]}}]
        },
        {
          "name": "Nodos",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/grafo/nodos" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Devuelve los 12 nodos', () => pm.expect(r).to.be.an('array').with.lengthOf(12));",
            "pm.test('Incluye CABA y CORRIENTES', () => {",
            "    const txt = JSON.stringify(r);",
            "    pm.expect(txt).to.include('CABA');",
            "    pm.expect(txt).to.include('CORRIENTES');",
            "});"
          ]}}]
        },
        {
          "name": "Rutas",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/grafo/rutas" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Devuelve las 17 rutas', () => pm.expect(r).to.be.an('array').with.lengthOf(17));",
            "pm.test('Cada ruta tiene origen, destino y minutos > 0', () => {",
            "    r.forEach(x => {",
            "        pm.expect(x).to.have.all.keys('origenId', 'destinoId', 'minutos');",
            "        pm.expect(x.minutos).to.be.above(0);",
            "    });",
            "});",
            "pm.test('Suma total de minutos = 1887', () => {",
            "    pm.expect(r.reduce((s, x) => s + x.minutos, 0)).to.eql(1887);",
            "});"
          ]}}]
        },
        {
          "name": "Paquetes",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/grafo/paquetes" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Devuelve las 8 cajas', () => pm.expect(r).to.be.an('array').with.lengthOf(8));",
            "pm.test('PQ-01: 8 kg, 520 USD, destino QUILMES', () => {",
            "    const p = r.find(x => x.id === 'PQ-01');",
            "    pm.expect(p).to.include({ pesoKg: 8, valor: 520, destinoId: 'QUILMES' });",
            "});"
          ]}}]
        }
      ]
    },
    {
      "name": "1-2. Recorridos (BFS y DFS)",
      "item": [
        {
          "name": "BFS desde CABA",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/recorridos/bfs?origen=CABA" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Orden de visita por niveles', () => {",
            "    pm.expect(r.ordenVisita).to.eql(['CABA','CAMPANA','LOMAS_DE_ZAMORA','PILAR','QUILMES','ROSARIO','ZARATE','LA_PLATA','PARANA','SANTA_FE','CORRIENTES','RESISTENCIA']);",
            "});",
            "pm.test('Saltos mínimos correctos', () => {",
            "    pm.expect(r.saltosDesdeOrigen).to.include({ CABA: 0, QUILMES: 1, ZARATE: 2, SANTA_FE: 2, CORRIENTES: 3, RESISTENCIA: 3 });",
            "});",
            "pm.test('Visita los 12 nodos', () => {",
            "    pm.expect(r.nodosVisitados).to.eql(12);",
            "    pm.expect(r.nodosNoAlcanzados).to.eql(0);",
            "});",
            "pm.test('Árbol de padres con 11 entradas', () => pm.expect(Object.keys(r.padres)).to.have.lengthOf(11));"
          ]}}]
        },
        {
          "name": "BFS acepta minúsculas y tildes (\"zárate\")",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/recorridos/bfs?origen=z%C3%A1rate" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Normaliza el origen a ZARATE', () => pm.expect(r.origen).to.eql('ZARATE'));",
            "pm.test('Empieza por ZARATE', () => pm.expect(r.ordenVisita[0]).to.eql('ZARATE'));"
          ]}}]
        },
        {
          "name": "DFS desde CABA",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/recorridos/dfs?origen=CABA" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Preorden correcto', () => {",
            "    pm.expect(r.ordenVisita).to.eql(['CABA','CAMPANA','PILAR','ZARATE','ROSARIO','PARANA','CORRIENTES','RESISTENCIA','SANTA_FE','LOMAS_DE_ZAMORA','LA_PLATA','QUILMES']);",
            "});",
            "pm.test('Postorden correcto (CABA termina último)', () => {",
            "    pm.expect(r.ordenFinalizacion).to.eql(['PILAR','SANTA_FE','RESISTENCIA','CORRIENTES','PARANA','ROSARIO','ZARATE','CAMPANA','QUILMES','LA_PLATA','LOMAS_DE_ZAMORA','CABA']);",
            "});",
            "pm.test('Visita los 12 nodos', () => pm.expect(r.nodosVisitados).to.eql(12));"
          ]}}]
        }
      ]
    },
    {
      "name": "3. Dijkstra",
      "item": [
        {
          "name": "CABA → CORRIENTES",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/caminos/dijkstra?origen=CABA&destino=CORRIENTES" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Alcanzable, 747 minutos, 4 saltos', () => {",
            "    pm.expect(r.alcanzable).to.eql(true);",
            "    pm.expect(r.costoMinutos).to.eql(747);",
            "    pm.expect(r.saltos).to.eql(4);",
            "});",
            "pm.test('Camino por Rosario, Santa Fe y Resistencia', () => {",
            "    pm.expect(r.camino).to.eql(['CABA','ROSARIO','SANTA_FE','RESISTENCIA','CORRIENTES']);",
            "});",
            "pm.test('La suma de los tramos da el costo', () => {",
            "    pm.expect(r.tramos.reduce((s, t) => s + t.minutos, 0)).to.eql(r.costoMinutos);",
            "});"
          ]}}]
        },
        {
          "name": "CABA → LA_PLATA (dos caminos posibles)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/caminos/dijkstra?origen=CABA&destino=la%20plata" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('85 minutos por Quilmes (no 92 por Lomas)', () => {",
            "    pm.expect(r.costoMinutos).to.eql(85);",
            "    pm.expect(r.camino).to.eql(['CABA','QUILMES','LA_PLATA']);",
            "});"
          ]}}]
        },
        {
          "name": "Origen = destino",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/caminos/dijkstra?origen=CABA&destino=CABA" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Costo 0 y 0 saltos', () => {",
            "    pm.expect(r.costoMinutos).to.eql(0);",
            "    pm.expect(r.saltos).to.eql(0);",
            "});"
          ]}}]
        }
      ]
    },
    {
      "name": "4-5. Árbol de expansión mínima (Prim y Kruskal)",
      "item": [
        {
          "name": "Prim desde CABA",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/mst/prim?origen=CABA" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Costo 907, 11 aristas, 12 nodos, conexo', () => {",
            "    pm.expect(r.costoTotalMinutos).to.eql(907);",
            "    pm.expect(r.aristasEnArbol).to.eql(11);",
            "    pm.expect(r.nodosCubiertos).to.eql(12);",
            "    pm.expect(r.conexo).to.eql(true);",
            "});",
            "pm.test('La suma de las aristas da 907', () => {",
            "    pm.expect(r.aristas.reduce((s, a) => s + a.minutos, 0)).to.eql(907);",
            "});",
            "pm.test('Crece desde CABA: primera arista CABA–LOMAS (32)', () => {",
            "    pm.expect(r.aristas[0]).to.eql({ desde: 'CABA', hasta: 'LOMAS_DE_ZAMORA', minutos: 32 });",
            "});",
            "// Guarda las aristas para compararlas con Kruskal",
            "const clave = a => [a.desde, a.hasta].sort().join('-') + ':' + a.minutos;",
            "pm.collectionVariables.set('aristasPrim', JSON.stringify(r.aristas.map(clave).sort()));"
          ]}}]
        },
        {
          "name": "Prim desde CORRIENTES (mismo árbol)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/mst/prim?origen=CORRIENTES" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Mismo costo desde otro origen (árbol único)', () => pm.expect(r.costoTotalMinutos).to.eql(907));",
            "pm.test('Primera arista RESISTENCIA–CORRIENTES (22)', () => pm.expect(r.aristas[0].minutos).to.eql(22));"
          ]}}]
        },
        {
          "name": "Kruskal",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/mst/kruskal" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Costo 907, 11 aristas, conexo, sin origen', () => {",
            "    pm.expect(r.costoTotalMinutos).to.eql(907);",
            "    pm.expect(r.aristasEnArbol).to.eql(11);",
            "    pm.expect(r.conexo).to.eql(true);",
            "    pm.expect(r.origen).to.eql(null);",
            "});",
            "pm.test('Agrega las aristas en orden creciente de peso', () => {",
            "    pm.expect(r.aristas.map(a => a.minutos)).to.eql([20, 22, 25, 28, 32, 35, 45, 55, 105, 120, 420]);",
            "});",
            "pm.test('Descarta las que cierran ciclo (40, 60, 80, 150, 200, 450)', () => {",
            "    const pesos = r.aristas.map(a => a.minutos);",
            "    [40, 60, 80, 150, 200, 450].forEach(p => pm.expect(pesos).to.not.include(p));",
            "});",
            "pm.test('Mismas aristas que Prim (correr Prim antes)', () => {",
            "    const prim = pm.collectionVariables.get('aristasPrim');",
            "    if (!prim) { return; }",
            "    const clave = a => [a.desde, a.hasta].sort().join('-') + ':' + a.minutos;",
            "    pm.expect(JSON.stringify(r.aristas.map(clave).sort())).to.eql(prim);",
            "});"
          ]}}]
        }
      ]
    },
    {
      "name": "6-7. Ordenamiento (QuickSort y MergeSort)",
      "item": [
        {
          "name": "QuickSort por valor desc",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/paquetes/ordenar/quicksort?criterio=valor&orden=desc" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Orden por valor de mayor a menor', () => {",
            "    pm.expect(r.paquetes.map(p => p.id)).to.eql(['PQ-04','PQ-03','PQ-07','PQ-05','PQ-02','PQ-01','PQ-06','PQ-08']);",
            "});",
            "pm.test('Valores no crecientes', () => {",
            "    for (let i = 1; i < r.paquetes.length; i++) pm.expect(r.paquetes[i - 1].valor).to.be.at.least(r.paquetes[i].valor);",
            "});",
            "pm.test('Informa comparaciones (32)', () => pm.expect(r.comparaciones).to.eql(32));"
          ]}}]
        },
        {
          "name": "MergeSort por peso asc",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/paquetes/ordenar/mergesort?criterio=peso&orden=asc" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Orden por peso de menor a mayor', () => {",
            "    pm.expect(r.paquetes.map(p => p.id)).to.eql(['PQ-08','PQ-01','PQ-07','PQ-02','PQ-05','PQ-03','PQ-06','PQ-04']);",
            "});",
            "pm.test('Informa comparaciones (17)', () => pm.expect(r.comparaciones).to.eql(17));"
          ]}}]
        },
        {
          "name": "QuickSort y MergeSort coinciden (ratio desc)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/paquetes/ordenar/quicksort?criterio=ratio&orden=desc" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Ordena por valor/peso: PQ-07 primero', () => pm.expect(r.paquetes[0].id).to.eql('PQ-07'));",
            "pm.sendRequest(pm.collectionVariables.get('baseUrl') + '/api/paquetes/ordenar/mergesort?criterio=ratio&orden=desc', (err, res) => {",
            "    pm.test('MergeSort devuelve exactamente el mismo orden', () => {",
            "        pm.expect(err).to.eql(null);",
            "        pm.expect(res.json().paquetes.map(p => p.id)).to.eql(r.paquetes.map(p => p.id));",
            "    });",
            "});"
          ]}}]
        }
      ]
    },
    {
      "name": "8-9. Greedy y Mochila 0/1",
      "item": [
        {
          "name": "Greedy 40 kg",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/paquetes/greedy?capacidadKg=40" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Greedy carga 1870 USD en 36 kg', () => {",
            "    pm.expect(r.greedy.valorTotal).to.eql(1870);",
            "    pm.expect(r.greedy.pesoTotalKg).to.eql(36);",
            "});",
            "pm.test('No supera la capacidad', () => pm.expect(r.greedy.pesoTotalKg).to.be.at.most(40));",
            "pm.test('Orden considerado por ratio', () => {",
            "    pm.expect(r.greedy.ordenConsiderado).to.eql(['PQ-07','PQ-01','PQ-02','PQ-03','PQ-05','PQ-04','PQ-08','PQ-06']);",
            "});",
            "pm.test('No es óptimo: pierde 90 USD contra la mochila (1960)', () => {",
            "    pm.expect(r.comparacionConOptimo.valorOptimoMochila).to.eql(1960);",
            "    pm.expect(r.comparacionConOptimo.valorPerdidoPorElGreedy).to.eql(90);",
            "    pm.expect(r.comparacionConOptimo.greedyEsOptimo).to.eql(false);",
            "});"
          ]}}]
        },
        {
          "name": "Greedy contraejemplo",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/paquetes/greedy/contraejemplo" },
