# Copiá este archivo a ".env" (que está en .gitignore) y completá los valores.
# NO subas el .env real al repositorio. Neo4j exige una contraseña de 8+ caracteres.
# Con docker-compose.yml el usuario tiene que ser "neo4j": la imagen oficial no acepta otro usuario inicial.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
